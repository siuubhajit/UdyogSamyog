# ===================================================
# UDYOG SAMYOG — .gitignore
# ===================================================

# ── Node.js ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Environment Variables & Secrets ────────────────
# NEVER commit .env — it contains Gmail App Passwords and session secrets
.env
.env.*
!.env.example

# ── Logs & Console Dumps ───────────────────────────
*.log
logs/
server_out.log
server_err.log
out.txt

# ── Databases & Dump Files ─────────────────────────
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite3
data/*.sql
*.dump

# ── Uploads & User-Submitted Files ────────────────
# Keep the directory tracked via .gitkeep; never commit actual uploaded files
uploads/*
!uploads/.gitkeep

# ── Scratch / Dev Scripts ─────────────────────────
# Diagnostic, test, and one-off scripts — not part of the deployable app
scratch/

# ── Build Artefacts ───────────────────────────────
dist/
build/
.cache/
.parcel-cache/
.next/
out/

# ── Operating System Metadata ─────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editor & IDE Config ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.editorconfig.local

# ── Coverage & Testing Artefacts ──────────────────
coverage/
.nyc_output/
*.lcov
